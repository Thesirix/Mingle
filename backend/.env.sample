# Serveur
APP_PORT=5000
FRONTEND_URL=http://localhost:5173

# Base de données MySQL / MariaDB (valeurs du docker-compose.yml)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=mingle
DB_NAME=mingle

# Authentification (générez une longue chaîne aléatoire)
JWT_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire
# Durée de validité des sessions : "7d", "12h" ou un nombre de secondes
JWT_EXPIRES_IN=7d
